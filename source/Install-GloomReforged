; Gloom Reforged v2.3.2 - Installer 43.3 or newer
; Keep this script (and its project icon) next to the Setup drawer.
; No game data or binaries are embedded in this script.

(set @app-name "Gloom Reforged")
(set @default-dest "SYS:")

(onerror
    (message (cat "Gloom Reforged installation was not completed.\n\n"
                  @error-msg
                  "\n\nFiles already copied may remain in the destination."))
)

(if (< @installer-version 2818051)
    (abort "This installation requires Installer 43.3 or newer.")
)

; @icon is the absolute script path on CLI starts (Installer >= 42.12),
; or the project icon path on Workbench starts. Never use the caller's CWD.
(set #source-root (pathonly (expandpath @icon)))
(set #setup (tackon #source-root "Setup"))

(welcome "Install Gloom Reforged v2.3.2 into an existing game drawer.")

; 1. Game (one selection).
(set #game
    (askchoice
        (prompt "With which game would you like to use Gloom Reforged?")
        (help "Select the game installed in your destination drawer.")
        (choices "Gloom (Classic)" "Gloom Deluxe" "Gloom 3" "Zombie Massacre")
        (default 0)
    )
)
(set #game-drawer
    (select #game "Gloom" "Gloom Deluxe" "Gloom 3" "Zombie Massacre")
)

; 2. Chipset (askchoice, not a multi-selection askoptions).
(set #chipset
    (askchoice
        (prompt "Which chipset does your Amiga use?")
        (help "ECS installs the matching ECS-EHB assets. AGA or P96 leaves the game assets unchanged.")
        (choices "ECS" "AGA or P96")
        (default 1)
    )
)
(set #assets (tackon (tackon #setup "ECS-EHB-Assets") #game-drawer))

; 3. Binaries. PowerPacked filenames are preserved, including the .pp icon.
(set #binary-kind
    (askchoice
        (prompt "Do you want to use standard binaries or binaries compressed with PowerPacker?")
        (help "Select the standard or PowerPacker-compressed executables. GloomUpdate is always copied from Setup.")
        (choices "Standard" "Compressed (PowerPacker)")
        (default 0)
    )
)
(if (= #binary-kind 0)
    (
        (set #binary-source #setup)
        (set #bench "GloomBench")
        (set #game-binary "GloomReforged")
        (set #game-icon "GloomReforged.info")
    )
    (
        (set #binary-source (tackon #setup "PowerPacked-Binary"))
        (set #bench "GloomBench.pp")
        (set #game-binary "GloomReforged.pp")
        (set #game-icon "GloomReforged.pp.info")
    )
)

; 4. Destination.
(set #destination
    (askdir
        (prompt "Select the destination drawer for Gloom Reforged.")
        (help "Select the drawer containing the game selected in step 1. Existing matching files will be replaced.")
        (default @default-dest)
    )
)
(set @default-dest #destination)

; Validate the complete selected source set before copying anything.
(if (<> (exists (tackon #binary-source #bench)) 1)
    (abort (cat "Missing binary: " (tackon #binary-source #bench)))
)
(if (<> (exists (tackon #binary-source #game-binary)) 1)
    (abort (cat "Missing binary: " (tackon #binary-source #game-binary)))
)
(if (<> (exists (tackon #binary-source #game-icon)) 1)
    (abort (cat "Missing icon: " (tackon #binary-source #game-icon)))
)
(if (<> (exists (tackon #setup "GloomUpdate")) 1)
    (abort (cat "Missing updater: " (tackon #setup "GloomUpdate")))
)
(if (= #chipset 0)
    (if (<> (exists #assets) 2)
        (abort (cat "Missing ECS-EHB asset drawer: " #assets))
    )
)

; 5. Install. A copy error must abort, never report success.
(if (= #chipset 0)
    (copyfiles
        (prompt "Installing ECS-EHB assets...")
        (help @copyfiles-help)
        (source #assets)
        (dest #destination)
        (all)
        (infos)
        (optional "fail" "force")
    )
)
(copyfiles
    (prompt "Installing Gloom Reforged binaries...")
    (help @copyfiles-help)
    (source #binary-source)
    (dest #destination)
    (choices #bench #game-binary #game-icon)
    (optional "fail" "force")
)
(copyfiles
    (prompt "Installing GloomUpdate...")
    (help @copyfiles-help)
    (source (tackon #setup "GloomUpdate"))
    (dest #destination)
    (optional "fail" "force")
)

(complete 100)
(if @pretend
    (message "Simulation completed. No files have been installed.")
    (message "Gloom Reforged has been installed.")
)
(exit (quiet))
